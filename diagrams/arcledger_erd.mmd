erDiagram
    CUSTOMER ||--o{ ACCOUNT : owns
    BRANCH ||--o{ ACCOUNT : "opened at"
    ACCOUNT ||--o{ TRANSACTIONS : "debited or credited by"
    TRANSACTIONS ||--o| TRANSACTION_TRANSFER : "specialised as"
    ACCOUNT ||--o{ TRANSACTION_TRANSFER : "receives (destination)"
    TRANSACTIONS ||--o{ TRANSACTION_LOGS : "records events in"

    CUSTOMER {
        int customer_id PK
        varchar first_name
        varchar last_name
        char bvn UK
        varchar phone UK
        varchar email "nullable"
        date date_of_birth
    }
    BRANCH {
        int branch_id PK
        varchar branch_name
        varchar city
        varchar state
    }
    ACCOUNT {
        int account_id PK
        char account_number UK
        int customer_id FK
        int branch_id FK
        enum account_type "SAVINGS, CURRENT"
        decimal balance "CHECK >= 0"
        enum status "ACTIVE, CLOSED"
        date opened_date
    }
    TRANSACTIONS {
        int transaction_id PK
        varchar transaction_ref UK
        int account_id FK
        enum transaction_type "DEPOSIT, WITHDRAWAL, TRANSFER"
        decimal amount "CHECK > 0"
        enum status "SUCCESSFUL, FAILED"
        datetime transaction_date
    }
    TRANSACTION_TRANSFER {
        int transaction_id PK, FK
        int destination_account_id FK
    }
    TRANSACTION_LOGS {
        int log_id PK
        int transaction_id FK
        enum event "INITIATED, SUCCESSFUL, FAILED, REVERSED"
        varchar message "nullable"
        datetime log_time
    }
